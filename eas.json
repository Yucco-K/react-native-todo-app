{
	"cli": {
		"version": ">= 16.0.0"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"channel": "development",
			"env": {
				"GOOGLE_SERVICE_INFO": "@file:GOOGLE_SERVICE_INFO"
			}
		},
		"preview": {
			"distribution": "internal",
			"channel": "preview",
			"ios": {
				"simulator": false
			},
			"android": {
				"buildType": "apk",
				"gradleCommand": ":app:assembleRelease"
			},
			"env": {
				"GOOGLE_SERVICE_INFO": "@file:GOOGLE_SERVICE_INFO"
			}
		},
		"production": {
			"channel": "production",
			"ios": {
				"simulator": false
			},
			"android": {
				"buildType": "app-bundle"
			},
			"env": {
				"GOOGLE_SERVICE_INFO": "@file:GOOGLE_SERVICE_INFO"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
